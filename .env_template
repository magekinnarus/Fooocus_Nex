# Save this file as .env
 
 # === Hugging Face ===
 # Generate a token at: https://huggingface.co/settings/tokens
 HUGGINGFACE_TOKEN="put your Hugging Face token here"
 
 # === CivitAI ===
 # Generate an API key at: https://civitai.com/user/account (API Keys section)
 CIVITAI_TOKEN="put your CivitAI API key here"
 
 # === Zrok (Colab tunnel) ===
 # Optional. Used for Colab tunneling to expose the Gradio UI publicly.
 # Generate a token at: https://api.zrok.io
 ZROK_TOKEN="put your Zrok token here"
 
 # Optional Hugging Face mirror override
 # Uncomment and set if you need a download mirror:
 # HF_MIRROR="https://hf-mirror.com"
